# ==============================================================================
# TELECOM NETWORKS - INTRANET CORPORATIVA (.env.example)
# Plantilla de variables de entorno para desarrollo y producción.
# ADVERTENCIA: NUNCA coloques credenciales reales en este archivo ni lo subas con secretos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos Principal (MySQL / MariaDB vía Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://USUARIO_DB:PASSWORD_DB@127.0.0.1:3306/NOMBRE_BASE_DATOS"
MYSQL_ROOT_PASSWORD="PASSWORD_ROOT_SEGURO_MYSQL"
MYSQL_DATABASE="intranet"

# ------------------------------------------------------------------------------
# 2. Configuración de Autenticación (NextAuth v4)
# ------------------------------------------------------------------------------
# Genera NEXTAUTH_SECRET con: openssl rand -base64 32
NEXTAUTH_URL="https://intranet.tuorganizacion.com"
NEXTAUTH_SECRET="REEMPLAZAR_CON_STRING_CRIPTOGRAFICO_ALEATORIO_MIN_32_CHARS"

# Superadministrador inicial de la plataforma (Bypass administrativo controlado)
SUPERADMIN_EMAIL="admin@tuorganizacion.com"

# ------------------------------------------------------------------------------
# 3. Microsoft Entra ID (Azure AD) - SSO Corporativo Single-Tenant
# ------------------------------------------------------------------------------
AZURE_AD_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_AD_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_AD_CLIENT_SECRET="REEMPLAZAR_CON_CLIENT_SECRET_GENERADO_EN_AZURE"

# Grupos de Microsoft 365 para sincronización automática de roles (OIDs de Azure AD)
AZURE_AD_GROUP_TECHNOLOGY="00000000-0000-0000-0000-000000000000"
AZURE_AD_GROUP_HR="00000000-0000-0000-0000-000000000000"
AZURE_AD_GROUP_MANAGER="00000000-0000-0000-0000-000000000000"
AZURE_AD_GROUP_SUPERVISOR="00000000-0000-0000-0000-000000000000"

# ------------------------------------------------------------------------------
# 4. Servidor de Correo Saliente (SMTP / Notificaciones y Vacaciones)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="notificaciones@tuorganizacion.com"
SMTP_PASSWORD="PASSWORD_O_APP_PASSWORD_SMTP"
SMTP_FROM="Telecom Networks <notificaciones@tuorganizacion.com>"
SMTP_SECURE="false"

# ------------------------------------------------------------------------------
# 5. Caché y Sesiones Rápidas (Redis)
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# ------------------------------------------------------------------------------
# 6. Integraciones de Inteligencia Artificial (AI Hub / SupportBot)
# ------------------------------------------------------------------------------
# NVIDIA NIM AI API
NVIDIA_API_KEY="nvapi-REEMPLAZAR_CON_API_KEY_NVIDIA"
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"

# Google Generative AI (Gemini)
GEMINI_API_KEY="AIzaSy_REEMPLAZAR_CON_GEMINI_API_KEY"

# Ollama Local / On-Premise Instance
OLLAMA_HOST="http://127.0.0.1:11434"

# ------------------------------------------------------------------------------
# 7. Integración WhatsApp (WhatsApp Web Client)
# ------------------------------------------------------------------------------
ENABLE_WHATSAPP="false"

# ------------------------------------------------------------------------------
# 8. Sincronización Externa de Grupos y Métricas (DeskTime / WFM Platform)
# ------------------------------------------------------------------------------
DESKTIME_DB_HOST="127.0.0.1"
DESKTIME_DB_USER="usuario_lectura_wfm"
DESKTIME_DB_PASSWORD="PASSWORD_ACCESO_SOLO_LECTURA"
DESKTIME_DB_NAME="wfm_platform"

# ------------------------------------------------------------------------------
# 9. Credenciales de Despliegue DevOps / SSH (Opcional, para scripts de despliegue)
# ------------------------------------------------------------------------------
REMOTE_HOST="192.168.0.100"
REMOTE_USER="deploy_user"
REMOTE_PASSWORD="PASSWORD_SSH_O_DEJAR_VACIO_SI_SE_USA_LLAVE_SSH"
REMOTE_DIR="/var/www/html"
