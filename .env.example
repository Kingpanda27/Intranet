# ==========================================
# Telecom Networks Intranet Environment Config
# ==========================================

# Base Database Connection (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/intranet"

# NextAuth Configuration
NEXTAUTH_URL="https://intranet.telecomnetworks.org"
NEXTAUTH_SECRET="REEMPLAZA_CON_UNA_CLAVE_SECRETA_LARGA_Y_ALEATORIA"

# Microsoft Entra ID (Azure AD) Single-Tenant
AZURE_AD_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_AD_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_AD_CLIENT_SECRET="REPLACE_WITH_ENTRA_CLIENT_SECRET"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Email Notifications (SMTP)
EMAIL_HOST="smtp.office365.com"
EMAIL_PORT="587"
EMAIL_USER="notifications@tnoutsourcing.com"
EMAIL_PASS="REPLACE_WITH_SMTP_PASSWORD"
EMAIL_FROM="Telecom Networks <notifications@tnoutsourcing.com>"
