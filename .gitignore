# ==============================================================================
# TELECOM NETWORKS - .gitignore (Blindaje Exhaustivo de Seguridad)
# ==============================================================================

# --- Archivos de Entorno y Secretos ---
.env
.env.*
*.env
!.env.example

# --- Claves Criptográficas, Certificados y SSH ---
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
id_rsa
id_rsa*
id_ed25519
id_ed25519*

# --- Dependencias y Módulos ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Compilación y Salidas de Build ---
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# --- Testing y Cobertura ---
/coverage/

# --- Logs y Reportes de Ejecución ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# --- Archivos de Sistema Operativo e IDEs ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# --- Binarios, Paquetes Comprimidos y Ejecutables ---
*.exe
cloudflared.exe
*.tar.gz
*.zip
*.7z
app.tar.gz

# --- Bases de Datos Locales, Backups y Dumps ---
*.sql
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
database_live_backup.sql
_historical_sql_backups/
_legacy_intranet/
prisma/*.db*
SERVER_MIGRATION_PACKAGE/
storage/
/storage/

# --- Configuración Docker Local ---
docker-compose.override.yml

# --- Scripts de Infraestructura, Despliegue SSH y Mantenimiento Sensible ---
# Previene la fuga accidental de scripts con IPs privadas o credenciales hacia GitHub
/*.mjs
!eslint.config.mjs
/*.js
/*.ps1
/*.bat
scripts/deploy_*.mjs
scripts/deploy_*.js
scripts/sync_*.mjs
scripts/sync_*.js
scripts/check_*.js
scripts/check_*.mjs
scripts/fix_*.js
scripts/fix_*.mjs
scripts/setup_*.js
scripts/setup_*.mjs
scripts/test_*.js
scripts/test_*.mjs
scripts/update_*.js
scripts/update_*.mjs
scripts/verify_*.mjs
scripts/migrate_*.js
